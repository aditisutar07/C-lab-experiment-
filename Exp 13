#include <iostream>
#include <vector>
#include <fstream>
#include <algorithm>
using namespace std;

class Student {
public:
    int roll;
    string name;
    float marks;

    Student(int r, string n, float m) {
        roll = r;
        name = n;
        marks = m;
    }

    void display() {
        cout << roll << "\t" << name << "\t" << marks << endl;
    }
};

class StudentManager {
    vector<Student> students;

public:
    void addStudent() {
        int r;
        string n;
        float m;

        cout << "Enter Roll No: ";
        cin >> r;

        cout << "Enter Name: ";
        cin >> n;

        cout << "Enter Marks: ";
        cin >> m;

        if (m < 0 || m > 100)
            throw "Invalid Marks!";

        students.push_back(Student(r, n, m));
        cout << "Student Added Successfully!\n";
    }

    void displayStudents() {
        cout << "\nRoll\tName\tMarks\n";
        for (auto &s : students)
            s.display();
    }

    void searchStudent() {
        int r;
        cout << "Enter Roll No: ";
        cin >> r;

        auto it = find_if(students.begin(), students.end(),
            [r](Student &s) {
                return s.roll == r;
            });

        if (it != students.end())
            it->display();
        else
            cout << "Student Not Found!\n";
    }

    void saveToFile() {
        ofstream file("students.csv");

        for (auto &s : students)
            file << s.roll << "," << s.name << "," << s.marks << "\n";

        file.close();
        cout << "Records Saved Successfully!\n";
    }
};

int main() {
    StudentManager sm;
    int choice;

    do {
        cout << "\n--- Student Management System ---\n";
        cout << "1. Add Student\n";
        cout << "2. Display Students\n";
        cout << "3. Search Student\n";
        cout << "4. Save Records\n";
        cout << "5. Exit\n";
        cout << "Enter Choice: ";
        cin >> choice;

        try {
            switch (choice) {
                case 1: sm.addStudent(); break;
                case 2: sm.displayStudents(); break;
                case 3: sm.searchStudent(); break;
                case 4: sm.saveToFile(); break;
                case 5: cout << "Exiting...\n"; break;
                default: cout << "Invalid Choice!\n";
            }
        }
        catch (const char* msg) {
            cout << msg << endl;
        }

    } while (choice != 5);

    return 0;
}
