#include <iostream>
#include <vector>
#include <map>
#include <unordered_map>
#include <algorithm>
using namespace std;

int main() {

    // Vector
    vector<int> marks = {75, 90, 65, 85, 95};

    // Map
    map<string, int> students = {
        {"Amit", 75},
        {"Riya", 90},
        {"Rahul", 65},
        {"Neha", 85},
        {"John", 95}
    };

    // Unordered Map
    unordered_map<string, int> data = {
        {"Amit", 75},
        {"Riya", 90},
        {"Rahul", 65}
    };

    // Sort marks
    sort(marks.begin(), marks.end());

    cout << "Sorted Marks: ";
    for (int m : marks)
        cout << m << " ";

    // Find marks greater than 80
    auto it = find_if(marks.begin(), marks.end(),
                      [](int m) { return m > 80; });

    if (it != marks.end())
        cout << "\nFirst mark above 80: " << *it;

    // Transform marks by adding 5
    transform(marks.begin(), marks.end(),
              marks.begin(),
              [](int m) { return m + 5; });

    cout << "\nUpdated Marks: ";
    for (int m : marks)
        cout << m << " ";

    // Display student records
    cout << "\n\nStudent Records:\n";
    for (auto s : students)
        cout << s.first << " : " << s.second << endl;

    cout << "\nUnordered Map Records:\n";
    for (auto d : data)
        cout << d.first << " : " << d.second << endl;

    return 0;
}
