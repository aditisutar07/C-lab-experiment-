#include <iostream>
using namespace std;

int main() {
    // Variables and Data Types
    int age;
    float marks;
    char grade;
    string name;
    bool pass;

    // Constant
    const float PI = 3.14;

    // Input
    cout << "Enter Name: ";
    cin >> name;

    cout << "Enter Age: ";
    cin >> age;

    cout << "Enter Marks: ";
    cin >> marks;

    // Operators
    float total = marks + 10;
    float average = total / 2;
    pass = (marks >= 40);

    grade = (marks >= 75) ? 'A' : 'B';

    // Output
    cout << "\n--- Student Details ---" << endl;
    cout << "Name: " << name << endl;
    cout << "Age: " << age << endl;
    cout << "Marks: " << marks << endl;
    cout << "Total: " << total << endl;
    cout << "Average: " << average << endl;
    cout << "Grade: " << grade << endl;
    cout << "Pass: " << pass << endl;
    cout << "Constant PI: " << PI << endl;

    return 0;
}
